<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollStatement"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnShareStatement">

        <LinearLayout
            android:id="@+id/layoutStatement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/white">

            <!-- Verification Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/slate_50"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VERIFIED STATEMENT"
                        android:textColor="@color/success"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:id="@+id/tvStatementHash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHA-256: 4f8a...2d91"
                        android:textSize="8sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivQrVerification"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_main" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/slate_200"
                android:layout_marginVertical="16dp"/>

            <!-- Bank Header Style -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMART WALLET AI"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:letterSpacing="0.2"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENTERPRISE FINANCIAL REPORT"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_app_logo" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/slate_100"
                android:layout_marginVertical="16dp"/>

            <!-- User Info -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Holder: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvStatementName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Period: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/tvStatementPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="October 2023"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generated On: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/tvStatementDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2023-10-27"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Statement ID: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/tvStatementId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SWAI-XXXXX"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </GridLayout>

            <!-- Summary Table -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:background="@color/slate_50"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Inflow"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvStatementInflow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR 0"
                        android:textColor="@color/success"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Outflow"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvStatementOutflow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR 0"
                        android:textColor="@color/danger"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Net Bachat"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvStatementSavings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR 0"
                        android:textColor="@color/primary"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSACTION DETAILS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:textColor="@color/text_main"/>

            <!-- Table Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp"
                android:background="@color/slate_100"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.5"
                    android:text="DATE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:text="DESCRIPTION"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.5"
                    android:text="AMOUNT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Transactions List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStatementTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="*** End of Statement ***"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIGITALLY SIGNED &amp; VERIFIED"
                    android:textColor="@color/success"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:alpha="0.6"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This is a secure, tamper-proof document from SmartWalletAI Enterprise Systems."
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_muted"
                    android:textSize="8sp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareStatement"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Download &amp; Share Statement"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cornerRadius="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>