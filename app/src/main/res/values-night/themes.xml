<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SmartWalletAI" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Main Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/primary_light</item>

        <item name="colorSecondary">@color/info</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/slate_900</item>
        <item name="android:statusBarColor">@color/slate_900</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorSurface">@color/slate_800</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/slate_700</item>
        <item name="colorOnSurfaceVariant">@color/slate_300</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Bottom Nav -->
        <item name="bottomNavigationStyle">@style/App.BottomNav</item>
    </style>

    <style name="App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/slate_800</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/App.BottomNav.ActiveIndicator</item>
    </style>

    <style name="App.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_dark</item>
    </style>

    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/slate_800</item>
        <item name="cardElevation">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.MediumComponent</item>
        <item name="strokeWidth">0dp</item>
    </style>

</resources>